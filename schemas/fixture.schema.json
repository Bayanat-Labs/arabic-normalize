{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arabic-normalize/fixture.schema.json",
  "title": "arabic-normalize conformance fixture (dev or acceptance)",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "split", "family", "policy_id", "input", "input_escaped", "expected_output",
               "expected_rules", "expected_lossy_flags", "expected_flags", "expected_offset_map",
               "expected_rejected_spans", "expected_diacritization_ratio", "rationale_en", "rationale_ar",
               "author", "created", "label", "synthetic", "reviewed_by", "review_verdict"],
  "properties": {
    "fixture_id": {"type": "string", "pattern": "^(dev|acc)-[0-9]{3}$"},
    "split": {"enum": ["dev", "acceptance"]},
    "family": {"type": "string"},
    "policy_id": {"type": "string"},
    "input": {"type": "string"},
    "input_escaped": {"type": "string"},
    "expected_output": {"type": "string"},
    "expected_rules": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_lossy_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "expected_offset_map": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}}]},
    "expected_rejected_spans": {"type": "array"},
    "expected_diacritization_ratio": {"type": ["number", "null"]},
    "rationale_en": {"type": "string", "minLength": 1},
    "rationale_ar": {"type": "string", "minLength": 1},
    "author": {"type": "string"},
    "created": {"type": "string"},
    "label": {"const": "synthetic/illustrative, authored by Bayanat Labs"},
    "synthetic": {"const": true},
    "reviewed_by": {"type": ["string", "null"]},
    "review_verdict": {"type": ["string", "null"]}
  }
}
