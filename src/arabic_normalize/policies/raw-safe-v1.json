{
  "policy_id": "raw-safe-v1",
  "version": 1,
  "spec": "arabic-normalize-spec-1",
  "unicode_version": "18.0.0",
  "unicode_form": "NFC",
  "idempotent": true,
  "stages": {
    "reject_invalid": "drop",
    "strip_controls": "strip",
    "presentation_forms": "keep",
    "ligatures_honorific": "keep",
    "bidi_zw": "strip-except-meaningful",
    "tatweel": "keep",
    "diacritics": "keep",
    "quranic_marks": "keep",
    "superscript_alef": "keep",
    "alef_variants": "keep",
    "alef_maqsura": "keep",
    "taa_marbuta": "keep",
    "hamza_carriers": "keep",
    "persian_urdu_letters": "keep",
    "digits": "keep",
    "punctuation": "keep",
    "whitespace": "keep",
    "latin_case": "keep"
  },
  "meta": {
    "title_en": "Raw-safe cleaning without letter changes, version 1",
    "title_ar": "تنظيف آمن دون تغيير الحروف، الإصدار 1",
    "description_en": "NFC plus removal of invalid code points and invisible controls (a meaningful ZWNJ or emoji ZWJ is kept). No letter, mark, digit or punctuation is changed. Recipe for text_diac columns and for display or legal uses.",
    "license": "CC-BY-4.0",
    "attribution": "Bayanat Labs (https://bayanatlabs.com)",
    "created": "2026-10-15",
    "status": "pilot"
  }
}
